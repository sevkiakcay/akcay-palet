# Copy to .env.local (local) or set in the hosting dashboard (production).

# Public address of the site — canonical URLs, hreflang, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.akcaypalet.com

# Palet Atölyesi quote e-mails (https://resend.com). Without RESEND_API_KEY the
# quote form still works: it hands the request to WhatsApp / the visitor's mail app.
RESEND_API_KEY=
# Where quote requests are delivered (defaults to the e-mail in src/lib/contact.ts).
QUOTE_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Akçay Palet <teklif@akcaypalet.com>".
QUOTE_FROM_EMAIL=
